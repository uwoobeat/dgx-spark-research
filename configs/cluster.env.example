# Copy to configs/cluster.env on the closed-network operator workstation.
# This file is gitignored. Do not commit real management IPs, usernames, or key paths.
# DGX_AGENT_MODE is deliberately not stored here. It is an explicit process/session
# gate; unset means external. Export internal only after the closed-network gate.

# eugr is the normal orchestration path. native is the independent/rollback path.
CLUSTER_LAUNCHER=eugr

DGX1_HOST="<DGX1_MANAGEMENT_IP_OR_HOSTNAME>"
DGX2_HOST="<DGX2_MANAGEMENT_IP_OR_HOSTNAME>"
SSH_USER="<DGX_SSH_USER>"
SSH_PORT=22
# Set empty only when an approved ssh-agent/default identity is already configured.
SSH_IDENTITY_FILE="<ABSOLUTE_PATH_TO_PRIVATE_KEY>"
SSH_KNOWN_HOSTS_FILE=state/known_hosts

# The SSH user must own this absolute directory on both nodes and be able to use Docker.
REMOTE_REPO="/home/<DGX_SSH_USER>/dgx-spark-research"
REMOTE_NODE_ENV_REL=state/node.env
DGX1_NODE_ENV=state/dgx1.node.env
DGX2_NODE_ENV=state/dgx2.node.env

# Create this mode-0600 file on DGX-1 only; never place its secret in this repository.
REMOTE_LITELLM_ENV="/home/<DGX_SSH_USER>/.config/dgx-llm/litellm.env"
HEALTH_TIMEOUT_SECONDS=3600
WORKER_START_DELAY_SECONDS=10

# Required when CLUSTER_LAUNCHER=eugr. These are approved individual files, not a
# GitHub repository checkout. The known_hosts path must be the SSH user's default.
REMOTE_EUGR_DIR=/opt/approved/eugr-launcher
REMOTE_EUGR_PYTHONPATH=/opt/approved/eugr-python
REMOTE_EUGR_MANIFEST=/srv/import/manifests/eugr-launcher-files.sha256
REMOTE_EUGR_KNOWN_HOSTS="/home/<DGX_SSH_USER>/.ssh/known_hosts"
